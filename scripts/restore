#!/bin/bash

#=================================================
# IMPORT GENERIC HELPERS
#=================================================
source _common.sh
source /usr/share/yunohost/helpers

ynh_script_progression "Restoring PigeonPod..."

ynh_restore_file --origin_path="$install_dir"
ynh_restore_file --origin_path="$data_dir"

# Reassert ownership because restored archives can carry the metadata of the
# machine that created them.
chown -R "$app:$app" "$install_dir" "$data_dir"

# Regenerate integration configs from current package templates.
ynh_config_add_nginx
ynh_config_add_systemd

mkdir -p "/var/log/$app"
touch "/var/log/$app/$app.log"
chown -R "$app:$app" "/var/log/$app"

yunohost service add "$app" --description="PigeonPod podcast feed service" --log="/var/log/$app/$app.log"
ynh_systemctl --service="$app" --action="start"

ynh_script_progression "Restore of PigeonPod completed"
