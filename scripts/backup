#!/bin/bash

#=================================================
# IMPORT GENERIC HELPERS
#=================================================
source _common.sh
source /usr/share/yunohost/helpers

ynh_script_progression "Backing up PigeonPod..."

# The install directory contains the built JAR.
ynh_backup --src_path="$install_dir" --is_big

# The data directory contains the SQLite database, downloaded media,
# covers, and PigeonPod-managed yt-dlp runtime files.
ynh_backup --src_path="$data_dir" --is_big

ynh_script_progression "Backup of PigeonPod completed"
