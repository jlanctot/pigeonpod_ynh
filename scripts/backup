#!/bin/bash

#=================================================
# IMPORT GENERIC HELPERS
#=================================================
source "$(dirname -- "${BASH_SOURCE[0]}")/_common.sh"
source /usr/share/yunohost/helpers

#=================================================
# BACKUP PIGEONPOD
#=================================================
ynh_script_progression "Backing up PigeonPod..."

# Back up the application installation directory.
ynh_backup "$install_dir"

# Back up the database, downloaded media, covers, and managed tools.
ynh_backup "$data_dir"

ynh_script_progression "Backup of PigeonPod completed"
